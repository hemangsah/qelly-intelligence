# Qelly externally hosted preview — copy to an encrypted host secret set, never commit values.
NODE_ENV=production
QELLY_DEPLOYMENT_ENVIRONMENT=preview
HOST=0.0.0.0
PORT=4480
QELLY_RUNTIME_DIR=/app/runtime

QELLY_PRODUCTION_FOUNDATION_ENABLED=true
QELLY_PRODUCTION_IDENTITY_ENABLED=true
QELLY_DEVELOPMENT_IDENTITY_ENABLED=false
QELLY_STRICT_PRODUCTION_DEPENDENCIES=true
QELLY_REQUIRE_ACTIVE_WORKER=true
QELLY_REQUIRED_MIGRATION=106_deployment_runtime_state.sql

QELLY_DATABASE_MODE=postgres
# Secret: pooled postgresql:// URL with sslmode=verify-full.
DATABASE_URL=
# Secret: direct, non-pooling postgresql:// URL with sslmode=verify-full.
QELLY_MIGRATION_DATABASE_URL=
QELLY_POSTGRES_POOL_MIN=1
QELLY_POSTGRES_POOL_MAX=12
QELLY_POSTGRES_CONNECT_TIMEOUT_MS=10000
QELLY_POSTGRES_STATEMENT_TIMEOUT_MS=30000
QELLY_POSTGRES_QUERY_TIMEOUT_MS=35000
QELLY_POSTGRES_IDLE_TIMEOUT_MS=30000
QELLY_POSTGRES_MAX_LIFETIME_SECONDS=1800
QELLY_POSTGRES_TLS_REJECT_UNAUTHORIZED=true
QELLY_POSTGRES_TLS_CA_BASE64=
QELLY_MIGRATION_LOCK_TIMEOUT_MS=30000
QELLY_MIGRATION_STATEMENT_TIMEOUT_MS=300000

QELLY_JOB_QUEUE_MODE=redis
# Secret: rediss:// URL for the private managed Redis instance.
REDIS_URL=
QELLY_REDIS_TLS_REJECT_UNAUTHORIZED=true
QELLY_REDIS_TLS_CA_BASE64=
# Optional TLS SNI override; leave blank to use the REDIS_URL hostname.
QELLY_REDIS_TLS_SERVERNAME=
QELLY_REDIS_CONNECT_TIMEOUT_MS=10000
QELLY_REDIS_COMMAND_TIMEOUT_MS=10000
QELLY_WORKER_ID=qelly-preview-worker-1
QELLY_WORKER_LEASE_MS=60000
QELLY_WORKER_HEARTBEAT_MS=10000
QELLY_WORKER_RECOVERY_MS=60000

QELLY_OBJECT_STORAGE_MODE=s3
S3_ENDPOINT=https://<private-s3-endpoint>
S3_BUCKET=qelly-preview-private
S3_REGION=<storage-region>
# Secrets: scoped credentials limited to this private bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true

QELLY_MALWARE_SCANNER_MODE=clamav
QELLY_REQUIRE_EXTERNAL_MALWARE_SCANNER=true
CLAMAV_HOST=<private-clamav-service-name>
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

QELLY_DELIVERY_MODE=external
QELLY_EMAIL_API_URL=https://<email-provider-host>/<send-endpoint>
QELLY_EMAIL_HEALTH_URL=https://<email-provider-host>/<health-endpoint>
# Secret: provider-issued API token.
QELLY_EMAIL_API_TOKEN=
# Secret: at least 32 cryptographically random characters.
QELLY_WEBHOOK_SIGNING_SECRET=
QELLY_OUTBOUND_ALLOWED_ORIGINS=https://<email-provider-host>,https://<preview-webhook-receiver>
QELLY_OUTBOUND_ALLOW_HTTP=false
QELLY_OUTBOUND_ALLOW_PRIVATE=false

# Secret: at least 32 cryptographically random characters.
QELLY_SESSION_SECRET=
QELLY_SESSION_COOKIE_SAME_SITE=None
# Secret: at least 24 cryptographically random characters.
QELLY_PASSWORD_PEPPER=
# Secret: JSON object mapping key IDs to exactly 32-byte encoded keys.
QELLY_SECRET_KEYRING_JSON=
QELLY_SECRET_ACTIVE_KEY_ID=preview-2026-01

QELLY_FRONTEND_ORIGINS=https://<frontend-preview-host>
QELLY_WEBAUTHN_RP_ID=<frontend-preview-hostname>
QELLY_WEBAUTHN_RP_NAME=Qelly Intelligence
QELLY_WEBAUTHN_ORIGINS=https://<frontend-preview-host>
QELLY_PUBLIC_API_BASE_URL=https://<api-preview-host>

QELLY_PUBLIC_MARKET_DATA_ENABLED=true
QELLY_LIVE_TRADING_ENABLED=false
QELLY_ASSET_TRANSFERS_ENABLED=false
QELLY_WITHDRAWALS_ENABLED=false
QELLY_PRIVATE_KEYS_ENABLED=false
QELLY_RECOVERY_PHRASES_ENABLED=false
