# Qelly local development only.
# Externally hosted preview: .env.preview.example
# Public production: .env.production.example
NODE_ENV=development
QELLY_DEPLOYMENT_ENVIRONMENT=development
HOST=127.0.0.1
PORT=4480
QELLY_RUNTIME_DIR=./runtime

QELLY_PRODUCTION_FOUNDATION_ENABLED=true
QELLY_PRODUCTION_IDENTITY_ENABLED=true
QELLY_DEVELOPMENT_IDENTITY_ENABLED=true
QELLY_STRICT_PRODUCTION_DEPENDENCIES=false
QELLY_DATABASE_MODE=sqlite
QELLY_SQLITE_PATH=./runtime/qelly-production-dev.sqlite
QELLY_JOB_QUEUE_MODE=database
QELLY_OBJECT_STORAGE_MODE=local
QELLY_MALWARE_SCANNER_MODE=local-signature
QELLY_DELIVERY_MODE=disabled

QELLY_SESSION_SECRET=replace-with-at-least-32-random-characters
QELLY_SESSION_COOKIE_SAME_SITE=Lax
QELLY_PASSWORD_PEPPER=
QELLY_SECRET_PROTECTION_KEY=replace-with-development-key-material
QELLY_WEBAUTHN_RP_ID=localhost
QELLY_WEBAUTHN_RP_NAME=Qelly Intelligence
QELLY_WEBAUTHN_ORIGINS=http://localhost:4480,http://127.0.0.1:4480
QELLY_FRONTEND_ORIGINS=

QELLY_PUBLIC_MARKET_DATA_ENABLED=true
QELLY_PUBLIC_MARKET_CACHE_TTL_MS=15000
QELLY_PUBLIC_MARKET_STALE_TTL_MS=300000
QELLY_LIVE_TRADING_ENABLED=false
QELLY_ASSET_TRANSFERS_ENABLED=false
QELLY_WITHDRAWALS_ENABLED=false
QELLY_PRIVATE_KEYS_ENABLED=false
QELLY_RECOVERY_PHRASES_ENABLED=false
