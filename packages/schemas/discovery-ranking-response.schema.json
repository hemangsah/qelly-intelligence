{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qelly.local/schemas/discovery-ranking-response.schema.json",
  "title": "Public Discovery Ranking Response",
  "type": "object",
  "required": ["items", "total", "nextCursor", "query", "mode", "source", "observedAt", "receivedAt"],
  "properties": {
    "items": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "total": {"type": "integer", "minimum": 0},
    "nextCursor": {"type": ["string", "null"]},
    "query": {"type": "object"},
    "mode": {"const": "deterministic-public-discovery-foundation"},
    "source": {"type": "string"},
    "observedAt": {"type": "string", "format": "date-time"},
    "receivedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["canonicalId", "symbol", "name", "assetClass", "category", "price", "change24h", "freshnessClass", "qualityFlags", "source"],
      "properties": {
        "canonicalId": {"type": "string"},
        "symbol": {"type": "string"},
        "name": {"type": "string"},
        "assetClass": {"type": "string"},
        "category": {"type": "string"},
        "price": {"type": "number"},
        "change24h": {"type": "number"},
        "marketCap": {"type": ["number", "null"]},
        "volume24h": {"type": ["number", "null"]},
        "freshnessClass": {"enum": ["live", "delayed", "cached", "stale", "simulated", "unavailable"]},
        "qualityFlags": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"}
      }
    }
  }
}
