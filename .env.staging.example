NODE_ENV=production
HOST=0.0.0.0
PORT=4480
QELLY_PRODUCTION_FOUNDATION_ENABLED=true
QELLY_PRODUCTION_IDENTITY_ENABLED=true
QELLY_DEVELOPMENT_IDENTITY_ENABLED=false
QELLY_DATABASE_MODE=postgres
DATABASE_URL=postgres://qelly:${POSTGRES_PASSWORD}@postgres:5432/qelly
QELLY_JOB_QUEUE_MODE=redis
REDIS_URL=redis://redis:6379
QELLY_OBJECT_STORAGE_MODE=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=qelly-staging
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_PATH_STYLE=true
QELLY_MALWARE_SCANNER_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
QELLY_DELIVERY_MODE=disabled
QELLY_SESSION_SECRET=replace-through-secret-manager
QELLY_PASSWORD_PEPPER=replace-through-secret-manager
QELLY_SECRET_KEYRING_JSON={"staging-2026-01":"replace-through-kms-integration"}
QELLY_SECRET_ACTIVE_KEY_ID=staging-2026-01
QELLY_WEBAUTHN_RP_ID=staging.qelly.example
QELLY_WEBAUTHN_ORIGINS=https://staging.qelly.example
