# Qelly Intelligence environment template
HOST=127.0.0.1
PORT=4480
NODE_ENV=development

# Local development: SQLite + database-backed queue + explicit fixture identity.
QELLY_PRODUCTION_FOUNDATION_ENABLED=true
QELLY_PRODUCTION_IDENTITY_ENABLED=true
QELLY_DEVELOPMENT_IDENTITY_ENABLED=true
QELLY_DATABASE_MODE=sqlite
QELLY_SQLITE_PATH=./runtime/qelly-production-dev.sqlite
QELLY_JOB_QUEUE_MODE=database

# Production: PostgreSQL + Redis + secure cookie identity.
DATABASE_URL=postgres://qelly:replace-me@127.0.0.1:5432/qelly
REDIS_URL=redis://127.0.0.1:6379/0
QELLY_SESSION_SECRET=replace-with-at-least-32-random-characters
QELLY_PASSWORD_PEPPER=
QELLY_SECRET_PROTECTION_KEY=replace-with-32-byte-base64-or-64-hex-key
QELLY_SEED_EMAIL=owner@example.com
QELLY_SEED_PASSWORD=
QELLY_SEED_DISPLAY_NAME=Qelly Owner
QELLY_SEED_ORGANIZATION=Qelly Labs
QELLY_SEED_WORKSPACE=Institutional Research

# WebAuthn / passkeys.
QELLY_WEBAUTHN_RP_ID=localhost
QELLY_WEBAUTHN_RP_NAME=Qelly Intelligence
QELLY_WEBAUTHN_ORIGINS=http://localhost:4480,http://127.0.0.1:4480

# Object storage. Use local only for development; production should use S3/MinIO.
QELLY_OBJECT_STORAGE_MODE=local
QELLY_ALLOW_LOCAL_OBJECT_STORAGE_IN_PRODUCTION=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=qelly
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=qelly
S3_SECRET_ACCESS_KEY=replace-me
S3_PATH_STYLE=true

# Delivery adapters. Set disabled until endpoints and credentials are configured.
QELLY_DELIVERY_MODE=disabled
QELLY_ALLOW_LOCAL_DELIVERY_IN_PRODUCTION=false
QELLY_WEBHOOK_SIGNING_SECRET=
QELLY_EMAIL_API_URL=
QELLY_EMAIL_API_TOKEN=

# Explicitly disabled or deferred safety boundaries.
QELLY_EXTERNAL_PROVIDERS_ENABLED=false
QELLY_LICENSED_DATA_ENABLED=false
QELLY_LIVE_TRADING_ENABLED=false
QELLY_ASSET_TRANSFERS_ENABLED=false
QELLY_WITHDRAWALS_ENABLED=false
QELLY_PRIVATE_KEYS_ENABLED=false
QELLY_RECOVERY_PHRASES_ENABLED=false
QELLY_EXTERNAL_TELEMETRY_ENABLED=false
QELLY_EXTERNAL_NOTIFICATIONS_ENABLED=false
QELLY_BROKER_CONNECTIONS_ENABLED=false
QELLY_COLLABORATION_ENABLED=false
QELLY_PUBLIC_MARKET_DATA_ENABLED=true
QELLY_PUBLIC_MARKET_CACHE_TTL_MS=15000
QELLY_PUBLIC_MARKET_STALE_TTL_MS=300000
# Legacy compatibility; prefer QELLY_PUBLIC_MARKET_DATA_ENABLED.
QELLY_LIVE_MARKET_ENABLED=false

# Account recovery and outbound-network policy
QELLY_EXPOSE_RECOVERY_CODE_IN_DEVELOPMENT=false
QELLY_OUTBOUND_ALLOWED_ORIGINS=
QELLY_OUTBOUND_ALLOW_HTTP=false
QELLY_OUTBOUND_ALLOW_PRIVATE=false
QELLY_OUTBOUND_DNS_VALIDATION=true
QELLY_SECURE_IMPORT_QUARANTINE_ENABLED=true

# Strict production dependency policy. Production defaults to strict and readiness fails
# when PostgreSQL, Redis, S3, ClamAV, external email, signed webhooks, or keyring
# configuration is unavailable. Set false only in an isolated diagnostic environment.
QELLY_STRICT_PRODUCTION_DEPENDENCIES=true
QELLY_MALWARE_SCANNER_MODE=local-signature
QELLY_REQUIRE_EXTERNAL_MALWARE_SCANNER=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
QELLY_SECRET_KEYRING_JSON=
QELLY_SECRET_ACTIVE_KEY_ID=
