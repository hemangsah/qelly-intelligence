{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"qelly.asset-comparison-request",
  "type":"object",
  "additionalProperties":false,
  "required":["canonicalIds"],
  "properties":{
    "canonicalIds":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":64}},
    "range":{"type":"string","enum":["1m","3m","6m","1y","2y"]}
  }
}
