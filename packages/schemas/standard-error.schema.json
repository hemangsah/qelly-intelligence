{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qelly.local/schemas/standard-error.schema.json",
  "title": "Qelly Error Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error",
    "correlationId"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": [
            "object",
            "array",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "correlationId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
