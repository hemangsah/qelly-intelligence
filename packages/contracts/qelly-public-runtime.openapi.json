{
  "openapi": "3.1.0",
  "info": {
    "title": "Qelly Public Runtime API",
    "version": "1.0.0-beta",
    "description": "Read-only status and provider APIs plus authenticated cloud-lifecycle and protected feedback contracts. No trading, custody or execution endpoints exist."
  },
  "servers": [
    {"url": "https://qelly-global-public-beta.pages.dev", "description": "Preferred Cloudflare deployment after authorization"},
    {"url": "https://hemangsah.github.io/qelly-intelligence", "description": "Deterministic static fallback; API routes unavailable"}
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {"200": {"description": "Truthful service health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}
      }
    },
    "/api/v1/runtime/status": {
      "get": {
        "operationId": "getPublicBetaStatus",
        "responses": {"200": {"description": "Deployment and external authorization state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublicBetaStatus"}}}}}
      }
    },
    "/api/v1/feedback": {
      "post": {
        "operationId": "submitFeedback",
        "parameters": [{"name": "X-Qelly-Turnstile", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 4096}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FeedbackRequest"}}}},
        "responses": {
          "202": {"description": "Accepted"},
          "400": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/v1/account/export": {
      "post": {
        "operationId": "exportAccountData",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Versioned user-owned export"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/account/deletion": {
      "post": {
        "operationId": "requestAccountDeletion",
        "security": [{"bearerAuth": []}],
        "responses": {"202": {"description": "Deletion requested"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/api/v1/sync/operations": {
      "post": {
        "operationId": "queueSyncOperation",
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SyncOperation"}}}},
        "responses": {"202": {"description": "Queued or replayed"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "Supabase JWT"}},
    "responses": {"Error": {"description": "Typed error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}},
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "mode", "releaseSha", "deterministicLocal", "authentication", "cloudSync", "protectedWrites", "trading", "custody", "privateKeys", "seedPhrases"],
        "properties": {
          "status": {"const": "ok"},
          "mode": {"const": "QELLY GLOBAL PUBLIC BETA"},
          "releaseSha": {"type": "string"},
          "deterministicLocal": {"const": true},
          "authentication": {"type": "boolean"},
          "cloudSync": {"type": "boolean"},
          "protectedWrites": {"type": "boolean"},
          "trading": {"const": false},
          "custody": {"const": false},
          "privateKeys": {"const": false},
          "seedPhrases": {"const": false}
        },
        "additionalProperties": false
      },
      "PublicBetaStatus": {
        "type": "object",
        "required": ["truthState", "deployment", "releaseSha", "services", "fallback"],
        "properties": {
          "truthState": {"const": "beta"},
          "deployment": {"type": "string"},
          "releaseSha": {"type": "string"},
          "services": {"type": "object", "additionalProperties": {"enum": ["active_verified", "configured_unverified", "external_authorization_required", "unavailable"]}},
          "fallback": {"type": "string", "format": "uri"}
        }
      },
      "FeedbackRequest": {
        "type": "object",
        "required": ["category", "message"],
        "properties": {
          "category": {"enum": ["bug", "accessibility", "data-quality", "privacy", "support", "feature"]},
          "message": {"type": "string", "minLength": 10, "maxLength": 4000},
          "pagePath": {"type": "string", "maxLength": 500}
        },
        "additionalProperties": false
      },
      "SyncOperation": {
        "type": "object",
        "required": ["clientOperationId", "type", "ownerId", "payload"],
        "properties": {
          "clientOperationId": {"type": "string", "format": "uuid"},
          "calculationId": {"type": ["string", "null"], "format": "uuid"},
          "ownerId": {"type": "string", "format": "uuid"},
          "type": {"enum": ["create", "update", "rename", "duplicate", "delete", "restore", "import"]},
          "baseRevision": {"type": ["integer", "null"], "minimum": 0},
          "payload": {"type": "object"}
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {"error": {"type": "string"}, "correlationId": {"type": "string"}},
        "additionalProperties": true
      }
    }
  }
}
