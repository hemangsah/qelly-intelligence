{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qelly.local/schemas/instrument-master.schema.json",
  "title": "Canonical Instrument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonicalId",
    "assetClass",
    "name",
    "symbols",
    "currency",
    "precision",
    "status",
    "relationships",
    "jurisdiction",
    "sourceLineage"
  ],
  "properties": {
    "canonicalId": {
      "type": "string",
      "pattern": "^QI-[A-Z0-9-]+$"
    },
    "assetClass": {
      "enum": [
        "crypto",
        "equity",
        "fund",
        "fx",
        "commodity",
        "fixed-income",
        "index",
        "derivative",
        "macro"
      ]
    },
    "name": {
      "type": "string"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "venue",
          "validFrom"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "precision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18
    },
    "status": {
      "enum": [
        "active",
        "inactive",
        "suspended",
        "planned"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "targetCanonicalId"
        ],
        "properties": {
          "type": {
            "enum": [
              "underlying",
              "wrapped",
              "tokenized",
              "constituent",
              "issuer",
              "derivative-of",
              "pair-base",
              "pair-quote"
            ]
          },
          "targetCanonicalId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "jurisdiction": {
      "type": "string"
    },
    "sourceLineage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
