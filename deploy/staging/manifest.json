{
  "productVersion": "0.9.0-preview.1",
  "name": "Qelly externally hosted preview workload manifest",
  "status": "repository-ready-awaiting-external-services",
  "workloads": [
    {"name":"migration-job","dockerfile":"Dockerfile.ops","persistent":false,"automaticOnColdStart":false},
    {"name":"api","dockerfile":"Dockerfile","persistent":true,"health":"/api/health","readiness":"/api/ready"},
    {"name":"worker","dockerfile":"Dockerfile.worker","persistent":true,"healthCommand":"node scripts/worker-health-check.mjs"},
    {"name":"frontend","host":"Vercel-or-static-CDN","build":"npm run build:frontend","output":"dist/frontend"}
  ],
  "externalDependencies": [
    {"name":"postgresql","required":true,"managed":true,"tls":true},
    {"name":"redis","required":true,"managed":true,"tls":true},
    {"name":"s3-compatible-storage","required":true,"private":true},
    {"name":"clamav","required":true,"network":"private-only"},
    {"name":"transactional-email","required":true,"transport":"HTTPS"},
    {"name":"webhook-receivers","required":true,"allowlist":"explicit-HTTPS"}
  ],
  "safety": {
    "liveTrading": false,
    "custody": false,
    "transfers": false,
    "withdrawals": false,
    "privateKeys": false,
    "recoveryPhrases": false
  },
  "truthBoundary": "This manifest describes deployable workloads. It is not evidence that external resources or a preview URL exist."
}
