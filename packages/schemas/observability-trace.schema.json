{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qelly.local/schemas/observability-trace.schema.json",
  "title": "Qelly Local Observability Trace",
  "type": "object",
  "required": ["traceId", "correlationId", "method", "path", "statusCode", "durationMs", "startedAt", "endedAt", "spanName", "service", "kind"],
  "properties": {
    "traceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
    "durationMs": { "type": "number", "minimum": 0 },
    "bytes": { "type": "integer", "minimum": 0 },
    "errorCode": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "spanName": { "type": "string", "minLength": 1 },
    "service": { "const": "qelly-bff" },
    "kind": { "const": "server" },
    "attributes": { "type": "object" }
  },
  "additionalProperties": true
}
